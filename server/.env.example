# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Supabase Credentials (from your Supabase Project Settings -> API)
# If left empty, the server automatically uses local fallback storage so you can test immediately!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret for protecting the scheduled scrape endpoint (/api/cron/scrape)
CRON_SECRET=super-secret-cron-token-ine-2026

# Target Mock Store URL
MOCK_STORE_URL=https://demo.inelabteamdev.com
